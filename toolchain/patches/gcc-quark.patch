diff --git a/gcc/config.gcc b/gcc/config.gcc
index 743421768ea..76fc619a023 100644
--- a/gcc/config.gcc
+++ b/gcc/config.gcc
@@ -776,6 +776,11 @@ x86_cpus="generic intel"

 # Common parts for widely ported systems.
 case ${target} in
+x86_64-*-quark*)
+  targ_defvec=x86_64_elf64_vec
+  targ_selvecs=
+  want64=true
+;;
 *-*-darwin*)
   tmake_file="t-darwin "
   tm_file="${tm_file} darwin.h"
@@ -1236,6 +1241,9 @@ case ${target} in
 esac

 case ${target} in
+x86_64-*-quark*)
+    tm_file="${tm_file} i386/unix.h i386/att.h elfos.h glibc-stdint.h i386/i386elf.h i386/x86-64.h quark.h gnu-user.h"
+    ;;
 aarch64*-*-elf | aarch64*-*-fuchsia* | aarch64*-*-rtems*)
 	tm_file="${tm_file} elfos.h newlib-stdint.h"
 	tm_file="${tm_file} aarch64/aarch64-elf.h aarch64/aarch64-errata.h aarch64/aarch64-elf-raw.h"
diff --git a/libgcc/config.host b/libgcc/config.host
index ac10ccc4340..c7667f465e8 100644
--- a/libgcc/config.host
+++ b/libgcc/config.host
@@ -389,6 +389,10 @@ i[34567]86-*-cygwin* | x86_64-*-cygwin*)
 esac

 case ${host} in
+x86_64-*-quark*)
+	extra_parts="$extra_parts crti.o crtbegin.o crtend.o crtn.o"
+	tmake_file="$tmake_file i386/t-crtstuff t-crtstuff-pic t-libgcc-pic"
+	;;
 aarch64*-*-elf | aarch64*-*-rtems*)
 	extra_parts="$extra_parts crtbegin.o crtend.o crti.o crtn.o"
 	extra_parts="$extra_parts crtfastmath.o"
diff --git a/libstdc++-v3/crossconfig.m4 b/libstdc++-v3/crossconfig.m4
index b3269cb88e0..8468052562e 100644
--- a/libstdc++-v3/crossconfig.m4
+++ b/libstdc++-v3/crossconfig.m4
@@ -5,6 +5,12 @@ dnl
 AC_DEFUN([GLIBCXX_CROSSCONFIG],[
 # Base decisions on target environment.
 case "${host}" in
+  *-quark*)
+    GLIBCXX_CHECK_COMPILER_FEATURES
+    GLIBCXX_CHECK_LINKER_FEATURES
+    GLIBCXX_CHECK_MATH_SUPPORT
+    GLIBCXX_CHECK_STDLIB_SUPPORT
+    ;;
   arm*-*-symbianelf*)
     # This is a freestanding configuration; there is nothing to do here.
     ;;
